# Server Port
PORT=5000

# Optional: Enforce email domain on registration (e.g., mitsgwl.ac.in).
# Leave commented or blank to permit any valid email address during development/testing.
# COLLEGE_EMAIL_DOMAIN=mitsgwl.ac.in

# Production Cloud Hosting (e.g., Render / Railway):
# Instead of uploading serviceAccountKey.json, paste the entire JSON string into this variable:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}